# Application
APP_ENV=development
DATABASE_URL=sqlite:///./vision_relevance.db

# Development tenant authentication
# Safe demo value only. Replace in a real deployment.
DEMO_API_KEY=demo-local-key

# Real local AI pipeline
VISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava:latest

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:latest

# Matching and safety thresholds
MIN_VISION_CONFIDENCE=0.60
MIN_SIMILARITY_SCORE=0.45
DUPLICATE_THRESHOLD=0.94

# Per-tenant AI budget guard
AI_BUDGET_USD=1.00

# Background worker
MAX_JOB_ATTEMPTS=3
WORKER_POLL_SECONDS=2.0

# Optional fallback image generation
# Disabled by default and not required for the core capstone.
IMAGE_GENERATION_PROVIDER=disabled
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_IMAGE_MODEL=flux
