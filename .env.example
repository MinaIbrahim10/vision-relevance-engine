APP_ENV=development
DATABASE_URL=sqlite:///./vision_relevance.db

# Vision provider
VISION_PROVIDER=gemini
GEMINI_API_KEY=

# Optional local vision provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=moondream

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Matching thresholds
MIN_VISION_CONFIDENCE=0.60
MIN_SIMILARITY_SCORE=0.45
DUPLICATE_THRESHOLD=0.94

# Budget guard
AI_BUDGET_USD=1.00
